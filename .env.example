# Free at https://www.pexels.com/api/ -- no cost, no credit card.
# Leave unset to run in placeholder-visual mode (useful for testing the pipeline).
PEXELS_API_KEY=

# edge (free, natural, needs internet), piper (free, natural, fully offline,
# needs a one-time model download -- see README), offline (espeak-ng, no
# download needed, but noticeably robotic), elevenlabs (best quality, but its
# free tier flagged one real account as "unusual activity" and locked it to
# paid-only -- your results may vary), or google (Google Cloud TTS, genuinely
# generous recurring free tier, needs a card on file to create the API key)
TTS_ENGINE=edge

# Any voice from `edge-tts --list-voices` (only used by TTS_ENGINE=edge)
TTS_VOICE=en-US-GuyNeural

# Only used by TTS_ENGINE=piper -- see README setup for the download command
PIPER_MODEL_PATH=voices/en-us-libritts-high.onnx
PIPER_SPEAKER_ID=90
# Pause between sentences within a scene, in seconds. Confirmed by listening
# comparison to matter more than speaker choice for how natural it sounds --
# without it, multi-sentence scenes run on with no breath between them.
PIPER_SENTENCE_SILENCE=0.35
# Raise these above Piper's defaults (0.667/0.8) for a less monotone
# delivery -- confirmed by listening comparison across 5 variants.
PIPER_NOISE_SCALE=1.0
PIPER_NOISE_W=1.1

# From https://elevenlabs.io/app/settings/api-keys after signing up. Only
# used by TTS_ENGINE=elevenlabs -- see README for setup and voice picking.
ELEVENLABS_API_KEY=
# Default is "Bill" -- picked after comparing it against "Dan" on a real
# script; both suit true-story/mystery narration, Bill won on preference.
# Browse others at https://elevenlabs.io/app/voice-library and copy the
# voice ID from there.
ELEVENLABS_VOICE_ID=lnUnPeUhSI5EcqtFBux7
# Delivery tuning, both 0.0-1.0. Lower stability = more pitch/pace variation
# (higher = flatter but more consistent); higher style = more exaggerated
# delivery (higher also means slower generation and less consistency
# between takes). Pushing either too far trades consistency for
# expressiveness across a whole script, not just a single line -- confirmed
# by ear at STABILITY=0.4/STYLE=0.35 (better in places, noticeably worse in
# others). Defaults below are a smaller, safer nudge off ElevenLabs' own
# baseline -- retune by ear, see README.
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.15

# From Google Cloud Console after enabling the Text-to-Speech API and
# creating an API key. Only used by TTS_ENGINE=google -- see README setup.
GOOGLE_TTS_API_KEY=
# Any voice name from https://cloud.google.com/text-to-speech/docs/voices
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-D
GOOGLE_TTS_LANGUAGE_CODE=en-US

# short (1080x1920, for Shorts) or long (1920x1080, for standard uploads)
VIDEO_FORMAT=short

# Optional, experimental -- see README "AI talking-head presenter" section.
# One-time free trial (~5 minutes of video) from your D-ID dashboard, not a
# repeatable per-video budget like everything else above.
D_ID_API_KEY=
